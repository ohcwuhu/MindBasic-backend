# 复制为 .env 后填写真实值；.env 已被 gitignore，禁止提交
APP_NAME=MindBasic
DEBUG=true
# 密码含特殊字符时需 URL 编码（如 @ -> %40）
DATABASE_URL=mysql+pymysql://mindbasic:<密码>@127.0.0.1:3306/mindbasic?charset=utf8mb4

# JWT 配置（生产环境务必更换为强随机密钥）
JWT_SECRET_KEY=<随机 64 位 hex>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
