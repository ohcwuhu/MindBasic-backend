# 复制为 .env 后填写真实值；.env 已被 gitignore，禁止提交
APP_NAME=MindBasic
# 生产环境必须为 false
DEBUG=true
# 必填；密码含特殊字符时需 URL 编码（如 @ -> %40）
DATABASE_URL=mysql+pymysql://mindbasic:<密码>@127.0.0.1:3306/mindbasic?charset=utf8mb4

# JWT 配置：必填且不能是占位值，缺失/占位会导致启动失败
JWT_SECRET_KEY=<随机 64 位 hex>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=14
# 生产环境必须为 true（HTTPS 下 httpOnly Cookie 才有效）
COOKIE_SECURE=false
LOG_LEVEL=INFO
# memory=进程内（单实例）；redis=多实例（需 REDIS_URL）
RATE_LIMIT_BACKEND=memory
REDIS_URL=
# 定时任务（订单超时释放/导出清理/孤儿文件扫描）；测试环境关闭
SCHEDULER_ENABLED=true
# 生产环境请显式配置允许的前端域名
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 邮箱验证码（登录/找回密码/绑定邮箱）
# EMAIL_ENABLED=true 后才会真正发送邮件；false 时验证码打印在后端日志
EMAIL_ENABLED=false
# QQ/163 邮箱用 465（SSL）；支持 STARTTLS 的服务用 587
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的邮箱地址
SMTP_PASSWORD=邮箱授权码（非登录密码）
SMTP_FROM=你的邮箱地址

# AI 实验室：DeepSeek 心理教练（可选，未配置时 AI 教练接口返回 503）
DEEPSEEK_API_KEY=

# AI 视频通话 LLM：Dify 智能体（可选；配置后优先走 Dify，未配置回退 DeepSeek）
# 云端 Dify 用 https://api.dify.ai/v1；本地 Docker Dify 用 http://127.0.0.1:18080/v1
# DIFY_API_BASE=https://api.dify.ai/v1
# DIFY_API_KEY=app-xxxxx

# AI 实验室：视频通话 TTS 语音合成（edge-tts，免费无需 API Key）
# 可选语音：zh-CN-XiaoxiaoNeural(晓晓·女) zh-CN-YunxiNeural(云希·男) zh-CN-XiaoyiNeural(晓伊·女)
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+0%

# AI 实验室：视频通话 VLM 视觉理解（可选，未配置时跳过视觉理解功能）
# 支持 OpenAI 兼容的 Vision API，如豆包/通义千问/智谱等
# VLM_API_KEY=
# VLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# VLM_MODEL=doubao-vision-pro-32k
