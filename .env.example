# 复制为 .env 后填写真实值；.env 已被 gitignore，禁止提交
APP_NAME=MindBasic
# 生产环境必须为 false
DEBUG=true
# 必填；密码含特殊字符时需 URL 编码（如 @ -> %40）
DATABASE_URL=mysql+pymysql://mindbasic:<密码>@127.0.0.1:3306/mindbasic?charset=utf8mb4

# JWT 配置：必填且不能是占位值，缺失/占位会导致启动失败
JWT_SECRET_KEY=<随机 64 位 hex>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=14
# 生产环境必须为 true（HTTPS 下 httpOnly Cookie 才有效）
COOKIE_SECURE=false
LOG_LEVEL=INFO
# memory=进程内（单实例）；redis=多实例（需 REDIS_URL）
RATE_LIMIT_BACKEND=memory
REDIS_URL=
# 定时任务（订单超时释放/导出清理/孤儿文件扫描）；测试环境关闭
SCHEDULER_ENABLED=true
# 视频通话长时间无语音的服务端兜底超时（秒）。前端 75s 会自己结束通话，
# 这里覆盖"标签页被挂起、前端定时器被节流"的情况；每 60 秒扫描一次。
# VC_IDLE_TIMEOUT_SECONDS=300
# 生产环境请显式配置允许的前端域名
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 邮箱验证码（登录/找回密码/绑定邮箱）
# EMAIL_ENABLED=true 后才会真正发送邮件；false 时验证码打印在后端日志
EMAIL_ENABLED=false
# QQ/163 邮箱用 465（SSL）；支持 STARTTLS 的服务用 587
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的邮箱地址
SMTP_PASSWORD=邮箱授权码（非登录密码）
SMTP_FROM=你的邮箱地址

# AI 实验室：DeepSeek 心理教练（可选，未配置时 AI 教练接口返回 503）
DEEPSEEK_API_KEY=
# 模型名与 Dify 工作流节点保持一致（工作流导出为 deepseek-v4-flash）。
# 直连实测：deepseek-v4-flash 与 deepseek-chat 由同一后端模型提供，
# 区别只在 v4-flash 默认开启推理。
# DEEPSEEK_MODEL=deepseek-v4-flash
# 关闭推理模式（默认开）。开启时模型先输出 reasoning_content 再给正文，
# 对实时语音等于"首 token 前先静默数秒"，且推理与正文共享 max_tokens：
# 实测 max_tokens=80 时全部被推理吃光、正文为空，直接判为"本轮无产出"。
# DEEPSEEK_DISABLE_REASONING=true
# 单轮最大生成 token（推理与正文共享该上限）
# DEEPSEEK_MAX_TOKENS=500
# 兜底轮次的"第二意见"风险自判（默认开）：Dify 不可用时补一次同口径判定，
# 使"平台 vs 生成侧"的一致性统计不因主路径抖动而丢样本；后台执行不占响应时间。
# FALLBACK_RISK_JUDGE=true

# AI 视频通话 LLM：Dify 智能体（可选）
# 选择规则：配了 Key → 每轮先试 Dify，本轮无产出就当场回退 DeepSeek；
#          连续失败 3 轮（DIFY_CIRCUIT_THRESHOLD）→ 熔断 120 秒
#          （DIFY_CIRCUIT_COOLDOWN）期间直接走 DeepSeek，冷却后自动再试。
#          想强制走 DeepSeek 就把下面两行注释掉。
# 详见 README「LLM 供应商选择与回退」。
# 云端 Dify 用 https://api.dify.ai/v1；本地 Docker Dify 用 http://127.0.0.1:18080/v1
# DIFY_API_BASE=https://api.dify.ai/v1
# DIFY_API_KEY=app-xxxxx
# DIFY_CIRCUIT_THRESHOLD=3
# DIFY_CIRCUIT_COOLDOWN=120
# LLM_RETRIES=3

# AI 实验室：视频通话 TTS 语音合成（edge-tts，免费无需 API Key）
# 可选语音：zh-CN-XiaoxiaoNeural(晓晓·女) zh-CN-YunxiNeural(云希·男) zh-CN-XiaoyiNeural(晓伊·女)
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+0%

# AI 实验室：视频通话 VLM 视觉理解（可选，未配置时跳过视觉理解功能）
# 支持 OpenAI 兼容的 Vision API，如豆包/通义千问/智谱等
# VLM_API_KEY=
# VLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# VLM_MODEL=doubao-vision-pro-32k

# 多模态融合：置信度校准（温度缩放）
# 默认关闭。fusion_service 输出的"最大概率"未经校准，不能直接当作置信度使用；
# 需先用真实标注数据跑 experiments/run_calibration.py 标定温度，再按下面三项开启。
# 标定参数必须来自真实数据，禁止直接填合成数据上的拟合值。
# FUSION_CALIBRATION_ENABLED=true
# FUSION_TEMPERATURE=0.85
# FUSION_CALIBRATION_SOURCE=2026-10 校园体验标注集 n=180 双人标注 kappa=0.81
